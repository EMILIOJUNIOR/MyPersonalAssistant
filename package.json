{
  "name": "lumia-agent",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "start": "eve start",
    "typecheck": "tsc",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "agenda:import": "node --env-file=.env.local --import tsx scripts/import-legacy-agenda.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.121",
    "@libsql/client": "^0.18.0",
    "ai": "^7.0.172",
    "eve": "^1.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.x",
    "just-bash": "^3.6.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vercel": "^66.6.0"
  },
  "engines": {
    "node": "26.x"
  }
}
